generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  low
  medium
  high
}

enum GoalStatus {
  active
  paused
  completed
  archived
}

enum TaskStatus {
  todo
  in_progress
  done
  archived
}

enum HabitFrequency {
  daily
  weekdays
  weekly
  monthly
  custom
}

enum HabitStatus {
  active
  paused
  archived
}

enum AIProvider {
  openai
  anthropic
  groq
}

enum LifeAreaType {
  health
  career
  relationships
  finance
  learning
  creativity
  spirituality
  home
  other
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  username      String?        @unique
  passwordHash  String?
  name          String?
  futureSelf    FutureSelf?
  lifeAreas     LifeArea[]
  goals         Goal[]
  habits        Habit[]
  habitLogs     HabitLog[]
  tasks         Task[]
  notes         Note[]
  dailyPlans    DailyPlan[]
  weeklyReviews WeeklyReview[]
  aiUsageLogs   AiUsageLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FutureSelf {
  id                String     @id @default(cuid())
  userId            String     @unique
  title             String
  description       String?
  identityStatement String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeAreas         LifeArea[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model LifeArea {
  id           String      @id @default(cuid())
  userId       String
  futureSelfId String?
  name         String
  type         LifeAreaType @default(other)
  vision       String?
  currentReality String?
  gap          String?
  deletedAt    DateTime?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  futureSelf   FutureSelf? @relation(fields: [futureSelfId], references: [id], onDelete: SetNull)
  goals        Goal[]
  notes        Note[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  lifeAreaId  String
  title       String
  description String?
  status      GoalStatus @default(active)
  priority    Priority  @default(medium)
  targetDate  DateTime?
  progress    Int       @default(0)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeArea    LifeArea  @relation(fields: [lifeAreaId], references: [id], onDelete: Cascade)
  habits      Habit[]
  tasks       Task[]
  notes       Note[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([lifeAreaId])
}

model Habit {
  id           String     @id @default(cuid())
  userId       String
  goalId       String?
  name         String
  description  String?
  frequency    HabitFrequency
  customFrequency String?
  reminderTime String?
  streak       Int        @default(0)
  status       HabitStatus @default(active)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs         HabitLog[]
  notes        Note[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([goalId])
}

model HabitLog {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  date      DateTime
  completed Boolean  @default(false)
  note      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId])
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  goalId      String?
  title       String
  description String?
  dueDate     DateTime?
  priority    Priority   @default(medium)
  status      TaskStatus @default(todo)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  notes       Note[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([goalId])
}

model Note {
  id         String    @id @default(cuid())
  userId     String
  goalId     String?
  habitId    String?
  taskId     String?
  lifeAreaId String?
  title      String
  body       String
  tags       String[]  @default([])
  aiSummary  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  habit      Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  lifeArea   LifeArea? @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model DailyPlan {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  priorities     String[] @default([])
  plan           Json
  suggestedTasks Json?
  reflectionPrompt String?
  aiProvider     String?
  aiModel        String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

model WeeklyReview {
  id                  String   @id @default(cuid())
  userId              String
  weekStart           DateTime
  weekEnd             DateTime
  summary             String
  wins                String[] @default([])
  gaps                String[] @default([])
  habitInsights       String[] @default([])
  goalProgress        String[] @default([])
  nextWeekSuggestions String[] @default([])
  aiContent           Json?
  aiProvider          String?
  aiModel             String?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, weekStart, weekEnd])
  @@index([userId])
}

model AiSettings {
  id        String     @id @default("global")
  provider  AIProvider @default(groq)
  model     String     @default("llama-3.1-8b-instant")
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  feature          String
  provider         String
  model            String
  status           String
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  estimatedCostUsd Decimal? @db.Decimal(12, 6)
  latencyMs        Int
  errorMessage     String?
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([provider, model])
  @@index([status])
  @@index([userId])
}
